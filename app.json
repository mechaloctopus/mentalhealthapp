{
  "expo": {
    "name": "MoodSignal",
    "slug": "moodsignal",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "moodsignal",
    "userInterfaceStyle": "dark",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "cover",
      "backgroundColor": "#090b0b"
    },
    "assetBundlePatterns": ["assets/**/*"],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "io.moodsignal.app",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "MoodSignal uses your microphone for short voice check-ins to estimate mood signals. Audio is analyzed on-device and never shared."
      }
    },
    "android": {
      "package": "io.moodsignal.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#090b0b"
      },
      "permissions": ["RECORD_AUDIO", "RECEIVE_BOOT_COMPLETED", "VIBRATE"]
    },
    "web": { "bundler": "metro", "favicon": "./assets/favicon.png" },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-av",
        { "microphonePermission": "MoodSignal uses your microphone for voice check-ins analyzed privately on your device." }
      ],
      [
        "expo-notifications",
        { "color": "#66e0ca" }
      ],
      "expo-asset"
    ],
    "experiments": { "typedRoutes": false }
  }
}
